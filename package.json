{
  "name": "nexus-n8n-workflow-kit",
  "private": true,
  "version": "0.1.0",
  "description": "A bilingual n8n workflow kit with importable enterprise automation flows and local validation.",
  "type": "module",
  "scripts": {
    "validate": "node scripts/validate-workflows.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "format": "prettier . --check",
    "format:write": "prettier . --write",
    "test": "npm run validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,mjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
